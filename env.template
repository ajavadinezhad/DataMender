# DataMender LLM Configuration
# Copy this file to .env and add your API key if using Groq

# ===== GROQ (Cloud - Recommended) =====
# Free tier, super fast (~5-10 seconds for all columns)
# Get free key at: https://console.groq.com
GROQ_API_KEY=gsk_your_key_here

# ===== OLLAMA (Local - Optional) =====
# Unlimited, private, runs on your machine (~15-30 seconds)
# No API key needed - runs via Docker
# 
# Setup:
#   docker run -d --name ollama -p 11434:11434 -v ollama_data:/root/.ollama ollama/ollama
#   docker exec -it ollama ollama pull llama3.2
#
# No configuration needed here!

